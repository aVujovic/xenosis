generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id        String   @id @default(uuid())
  type      String
  payload   String
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
