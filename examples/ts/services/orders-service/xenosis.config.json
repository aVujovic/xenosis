{
  "name": "orders-service",
  "peerName": "orders",
  "env": "development",
  "logLevel": "info",
  "port": 4018,
  "allowedOrigins": [
    "http://localhost:3000"
  ],
  "connectors": {
    "kafka": {
      "type": "kafka",
      "brokers": [
        "localhost:29092"
      ],
      "clientId": "orders-service"
    }
  },
  "events": {
    "orders": {
      "package": "@example/orders-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "producer",
      "publishes": [
        "orderCancelled",
        "orderConfirmed",
        "orderPlaced"
      ]
    },
    "payments": {
      "package": "@example/payments-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "consumer",
      "groupId": "orders-service-payments",
      "consumes": [
        "paymentCaptured",
        "paymentFailed"
      ]
    },
    "inventory": {
      "package": "@example/inventory-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "consumer",
      "groupId": "orders-service-inventory",
      "consumes": [
        "stockDepleted"
      ]
    }
  },
  "schemas": {},
  "peers": {
    "cart": {
      "package": "@example/cart-api",
      "transport": "http",
      "baseUrl": "http://localhost:4017",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    },
    "pricing": {
      "package": "@example/pricing-api",
      "transport": "http",
      "baseUrl": "http://localhost:4016",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    },
    "payments": {
      "package": "@example/payments-api",
      "transport": "http",
      "baseUrl": "http://localhost:4013",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    },
    "notifications": {
      "package": "@example/notifications-api",
      "transport": "http",
      "baseUrl": "http://localhost:4022",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    }
  },
  "authentication": {
    "enabled": false,
    "token": "",
    "exempt": [
      "/openapi.json",
      "/docs"
    ]
  }
}
