{
  "name": "orders-service",
  "peerName": "orders",
  "env": "development",
  "logLevel": "info",
  "port": 4018,
  "allowedOrigins": [
    "http://localhost:3000"
  ],
  "connectors": {},
  "schemas": {},
  "peers": {
    "cart": {
      "package": "@example/cart-api",
      "transport": "http",
      "baseUrl": "http://localhost:4017",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    },
    "pricing": {
      "package": "@example/pricing-api",
      "transport": "http",
      "baseUrl": "http://localhost:4016",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    },
    "inventory": {
      "package": "@example/inventory-api",
      "transport": "http",
      "baseUrl": "http://localhost:4015",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    },
    "payments": {
      "package": "@example/payments-api",
      "transport": "http",
      "baseUrl": "http://localhost:4013",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    }
  },
  "authentication": {
    "enabled": false,
    "token": "",
    "exempt": [
      "/openapi.json",
      "/docs"
    ]
  }
}
