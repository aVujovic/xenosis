{
  "name": "inventory-service",
  "peerName": "inventory",
  "env": "development",
  "logLevel": "info",
  "port": 4015,
  "allowedOrigins": [
    "http://localhost:3000"
  ],
  "connectors": {
    "kafka": {
      "type": "kafka",
      "brokers": [
        "localhost:29092"
      ],
      "clientId": "inventory-service"
    }
  },
  "events": {
    "orders": {
      "package": "@example/orders-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "consumer",
      "groupId": "inventory-service-orders",
      "consumes": [
        "orderPlaced"
      ]
    },
    "inventory": {
      "package": "@example/inventory-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "producer",
      "publishes": [
        "stockDepleted",
        "stockReserved"
      ]
    }
  },
  "schemas": {},
  "peers": {
    "catalog": {
      "package": "@example/catalog-api",
      "transport": "http",
      "baseUrl": "http://localhost:4014",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    }
  },
  "boundaries": {
    "allowedCallers": [
      "cart",
      "orders",
      "shipping"
    ]
  },
  "authentication": {
    "enabled": false,
    "token": "",
    "exempt": [
      "/openapi.json",
      "/docs"
    ]
  }
}
