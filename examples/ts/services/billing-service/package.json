    "awilix": "^12.0.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@xenosisorg/xenosis-testing": "workspace:*",
    "supertest": "^7.0.0",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.19.3",
