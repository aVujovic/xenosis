{
  "name": "billing-service",
  "peerName": "billing",
  "env": "development",
  "logLevel": "info",
  "port": 4002,
  "allowedOrigins": [
    "http://localhost:3000"
  ],
  "connectors": {},
  "peers": {
    "users": {
      "package": "@example/users-api",
      "transport": "http",
      "baseUrl": "http://localhost:4001",
      "timeoutMs": 5000,
      "retry": {
        "attempts": 2,
        "backoffMs": 200
      }
    }
  },
  "events": {
    "billing": {
      "package": "@example/billing-events",
      "transport": "memory",
      "mode": "producer"
    }
  },
  "authentication": {
    "enabled": false,
    "token": "",
    "exempt": [
      "/openapi.json",
      "/docs"
    ]
  }
}
