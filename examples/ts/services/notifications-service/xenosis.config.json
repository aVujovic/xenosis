{
  "name": "notifications-service",
  "peerName": "notifications",
  "env": "development",
  "logLevel": "info",
  "port": 4022,
  "allowedOrigins": [
    "http://localhost:3000"
  ],
  "connectors": {
    "kafka": {
      "type": "kafka",
      "brokers": [
        "localhost:29092"
      ],
      "clientId": "notifications-service"
    }
  },
  "schemas": {},
  "peers": {},
  "events": {
    "billing": {
      "package": "@example/billing-events",
      "transport": "memory",
      "mode": "consumer",
      "groupId": "notifications-billing",
      "consumes": [
        "chargeSucceeded"
      ]
    },
    "orders": {
      "package": "@example/orders-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "consumer",
      "groupId": "notifications-service-orders",
      "consumes": [
        "orderCancelled",
        "orderConfirmed",
        "orderPlaced"
      ]
    },
    "payments": {
      "package": "@example/payments-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "consumer",
      "groupId": "notifications-service-payments",
      "consumes": [
        "paymentFailed"
      ]
    },
    "inventory": {
      "package": "@example/inventory-events",
      "transport": "redpanda",
      "connector": "kafka",
      "mode": "consumer",
      "groupId": "notifications-service-inventory",
      "consumes": [
        "stockDepleted"
      ]
    }
  },
  "authentication": {
    "enabled": false,
    "token": "",
    "exempt": [
      "/openapi.json",
      "/docs"
    ]
  }
}
