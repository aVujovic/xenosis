{
  "name": "@xenosisorg/xenosis-core",
  "version": "0.2.0",
  "description": "Microservice toolkit for Node.js / TypeScript",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aVujovic/xenosis.git"
  },
  "homepage": "https://xenosis.org",
  "bugs": {
    "url": "https://github.com/aVujovic/xenosis/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "build": "tsc && tsup",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@prisma/client": "^6.7.0",
    "awilix": "^12.0.5",
    "cockatiel": "^3.2.1",
    "cors": "^2.8.5",
    "etcd3": "^1.1.2",
    "express": "^4.18.2",
    "glob": "^10.3.10",
    "ioredis": "^5.8.0",
    "kafkajs": "^2.2.4",
    "minimatch": "^10.0.0",
    "mongodb": "^6.9.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "ws": "^8.21.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "nats": "^2.28.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "nats": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "nats": "^2.28.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.0",
    "prisma": "^6.7.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "microservice",
    "typescript",
    "express",
    "awilix",
    "xenosis"
  ],
  "author": "Xenosis",
  "license": "MIT"
}
