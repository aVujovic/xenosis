{
  "name": "@xenosisorg/xenosis-mcp",
  "version": "0.2.1",
  "description": "MCP server that exposes a Xenosis workspace (peer graph, configs, health, OpenAPI) to AI assistants.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aVujovic/xenosis.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://xenosis.org",
  "bugs": {
    "url": "https://github.com/aVujovic/xenosis/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "xenosis-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "glob": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "tsup": "^8.4.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ]
}
