{
  "name": "{{serviceName}}",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/service.ts",
  "scripts": {
    "dev": "tsc-watch --noClear --onSuccess \"node --import tsx src/service.ts --config ./xenosis.config.json\"",
    "start": "node --import tsx src/service.ts --config ./xenosis.config.json",
    "build": "xenosis build",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xenosisorg/xenosis-core": "^0.1.0",
    "awilix": "^12.0.5",
    "tsx": "^4.19.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@xenosisorg/xenosis-cli": "^0.1.0",
    "@xenosisorg/xenosis-testing": "^0.1.0",
    "supertest": "^7.0.0",
    "tsc-watch": "^7.2.0",
    "tsup": "^8.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.0"
  }
}
